{
  "name": "quiz-creator-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Monorepo Quiz Creation & Spaced-Repetition Mastery System (MSRC + SOLID + SOC)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @quiz-creator/web dev",
    "dev:local": "pnpm --filter @quiz-creator/web dev:local",
    "dev:infisical": "pnpm dev",
    "mobile": "pnpm --filter @quiz-creator/mobile start",
    "build": "turbo run build",
    "start": "pnpm --filter @quiz-creator/web start",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:infisical": "infisical run -- pnpm test",
    "typecheck": "turbo run typecheck",
    "migrate": "node scripts/migrate.mjs",
    "migrate:infisical": "infisical run -- node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:infisical": "infisical run -- node scripts/seed.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "vitest": "^3.0.7"
  }
}