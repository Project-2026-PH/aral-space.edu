{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@quiz-creator/types": [
        "../../packages/types/src/index.ts"
      ],
      "@quiz-creator/core": [
        "../../packages/core/src/index.ts"
      ],
      "@quiz-creator/controllers": [
        "../../packages/controllers/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}